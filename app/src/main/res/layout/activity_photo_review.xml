<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Viewfinder Picture Display -->
    <ImageView
        android:id="@+id/imagePreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/label_enhanced"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/editorScrollPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- AI Futuristic Laser Scan Overlay -->
    <com.astracam.dualdevice.ui.AiScanOverlayView
        android:id="@+id/aiScanOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/editorScrollPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Floating AI Status Badge -->
    <TextView
        android:id="@+id/aiStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_chip"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="✨ Gemini AI Neural Vision Active..."
        android:textColor="@color/primary_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/editorScrollPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/processingIndicator"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/imagePreview"
        app:layout_constraintEnd_toEndOf="@id/imagePreview"
        app:layout_constraintStart_toStartOf="@id/imagePreview"
        app:layout_constraintTop_toTopOf="@id/imagePreview" />

    <!-- Translucent Frosted Glass Controls Panel -->
    <ScrollView
        android:id="@+id/editorScrollPanel"
        android:layout_width="0dp"
        android:layout_height="270dp"
        android:background="@drawable/bg_glass_panel"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Row: Radio Comparison & AI Trigger Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/toggleComparison"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbOriginal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_original"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbEnhanced"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:checked="true"
                        android:text="@string/label_enhanced"
                        android:textColor="@color/primary_accent"
                        android:textSize="12sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnGeminiAi"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="✨ GEMINI AI"
                    android:textColor="@color/primary_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Presets Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/presetNatural"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="NATURAL"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/presetHdr"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="DSLR HDR"
                        android:textColor="@color/badge_hdr"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/presetVivid"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="VIVID"
                        android:textColor="@color/primary_accent"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/presetNightClean"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="NIGHT CLEAN"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Sliders -->
            <TextView
                android:id="@+id/lblShadows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Shadow Recovery: 35%"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/sbShadows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="35"
                android:progressTint="@color/primary_accent"
                android:thumbTint="@color/primary_accent" />

            <TextView
                android:id="@+id/lblHighlights"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Highlight Compression: 25%"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/sbHighlights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="25"
                android:progressTint="@color/primary_accent"
                android:thumbTint="@color/primary_accent" />

            <TextView
                android:id="@+id/lblClarity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Clarity / Micro-Contrast: 25%"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/sbClarity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="25"
                android:progressTint="@color/primary_accent"
                android:thumbTint="@color/primary_accent" />

            <TextView
                android:id="@+id/lblWarmth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Color Temperature: Neutral (0)"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/sbWarmth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/primary_accent"
                android:thumbTint="@color/primary_accent" />

            <TextView
                android:id="@+id/lblSharpness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Edge Sharpness: 35%"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/sbSharpness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="35"
                android:progressTint="@color/primary_accent"
                android:thumbTint="@color/primary_accent" />

            <!-- Bottom Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#33FFFFFF"
                    android:text="@string/btn_back"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary_accent"
                    android:text="@string/btn_save_enhanced"
                    android:textColor="@color/black"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>